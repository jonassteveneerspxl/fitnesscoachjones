rules_version = '2';

// Elke gebruiker mag uitsluitend zijn eigen workouts lezen en schrijven: users/{uid}/workouts/{workoutId}.
// Alles wat hier niet expliciet staat, is geweigerd. Verwijderen kan niet: de app markeert een workout als
// verwijderd (veld `deletedAt`), zodat een fout of een gestolen sessie nooit gegevens definitief kan wissen.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Velden die na het aanmaken niet meer mogen veranderen (null = onbekend, zoals bij geïmporteerde data).
    function sameField(field) {
      return resource.data.get(field, null) == request.resource.data.get(field, null);
    }

    function validWorkout(uid, workoutId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'userId', 'exercises', 'trainingType', 'totalVolume'])
        && d.id == workoutId
        && d.userId == uid
        && d.exercises is list
        && d.exercises.size() <= 100
        && d.trainingType is string
        && d.totalVolume is number
        && d.keys().size() <= 30;
    }

    match /users/{uid}/workouts/{workoutId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) && validWorkout(uid, workoutId);

      allow update: if isOwner(uid) && validWorkout(uid, workoutId)
        && sameField('startedAt')
        && sameField('timeZone')
        && sameField('createdAt');

      allow delete: if false;
    }

    // Eigen oefeningen (aanvullingen op de ingebouwde lijst). Workouts bewaren alleen de naam, dus deze
    // mogen gewoon verwijderd worden zonder dat er trainingsdata verloren gaat.
    function validExercise(exerciseId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'name', 'createdAt'])
        && d.keys().hasOnly(['id', 'name', 'kind', 'muscleGroup', 'pplCategory', 'equipment', 'createdAt'])
        && d.id == exerciseId
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && (!('kind' in d) || d.kind in ['strength', 'time', 'cardio'])
        && (d.get('kind', 'strength') == 'cardio'
          // Cardio heeft geen spiergroep.
          ? (!('muscleGroup' in d) && !('pplCategory' in d))
          : (d.keys().hasAll(['muscleGroup', 'pplCategory'])
            && d.muscleGroup in ['chest', 'back', 'shoulders', 'biceps', 'triceps', 'forearms', 'quadriceps', 'hamstrings', 'glutes', 'calves', 'core']
            && d.pplCategory in ['push', 'pull', 'legs']))
        && (!('equipment' in d) || (d.equipment is string && d.equipment.size() <= 40));
    }

    match /users/{uid}/exercises/{exerciseId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validExercise(exerciseId);
      allow delete: if isOwner(uid);
    }
  }
}
